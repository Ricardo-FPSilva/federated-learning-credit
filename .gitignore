# Ambientes isolados: histórico e aplicação web permanecem separados.
/.venv/
/.venv-*/
/venv/
/env/

# Caches e bytecode; não ignorar resultados científicos por extensão.
/.uv-cache/
/.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
htmlcov/

# Temporários explicitamente separados dos registros científicos.
/tmp/
/results/tmp/
*.tmp
*.swp

# Não ignorar results/: protocolos, manifests, locks, métricas e logs
# de execução relevantes devem continuar visíveis para versionamento.
